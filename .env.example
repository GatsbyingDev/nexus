# =====================================================
# Nexus Monorepo Environment Variables
# =====================================================
# Copy this file to each app's .env or split values as:
# - apps/server/.env
# - apps/client/.env

# =====================================================
# Server (apps/server/.env)
# =====================================================

# Server runtime
PORT=
NODE_ENV=

# MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# JWT secrets and expirations
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed frontend origin
# Example: http://localhost:5173
CLIENT_URL=

# =====================================================
# Client (apps/client/.env)
# =====================================================

# Base API URL including /api/v1 prefix
# Example: http://localhost:5000/api/v1
VITE_API_URL=

# Socket server URL
# Example: http://localhost:5000
VITE_SOCKET_URL=
